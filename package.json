{
  "name": "ponjo",
  "version": "0.1.0",
  "description": "Co-author plain markdown with AI buddies: comment threads in a sidecar file and a desktop editor.",
  "author": "fanzhangg",
  "type": "module",
  "exports": {
    ".": "./src/core/index.js"
  },
  "files": [
    "src/",
    "spec/",
    "dist/",
    "agents/"
  ],
  "scripts": {
    "icon:desktop": "electron scripts/make-icon.cjs",
    "postinstall": "node scripts/patch-deps.js",
    "build": "node scripts/build.js",
    "desktop": "npm run build && electron desktop/main.js",
    "prepack": "npm run build",
    "lint": "eslint . && depcruise src web desktop scripts preview test && knip",
    "test": "node --test --test-timeout=300000 --test-force-exit \"test/*.test.js\"",
    "test:stress": "node --test --test-timeout=2400000 --test-force-exit \"test/stress/*.test.js\"",
    "test:perf": "node --test --test-concurrency=1 --test-timeout=1800000 --test-force-exit \"test/perf/*.test.js\"",
    "pack:desktop": "npm run build && electron-builder --dir",
    "dist:desktop": "npm run build && electron-builder",
    "smoke:desktop": "node scripts/smoke-desktop.js",
    "bench:agent": "node scripts/bench-agent.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "approx-string-match": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-cjk-friendly": "2.0.2",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@milkdown/kit": "7.22.2",
    "dependency-cruiser": "18.7.0",
    "electron": "44.4.5",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "knip": "6.42.1",
    "mermaid": "11.17.2",
    "remark-cjk-friendly": "2.3.2"
  }
}
